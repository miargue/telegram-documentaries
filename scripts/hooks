#!/usr/bin/env bash
# Pre-commit checks: lint + type checks (+ compile/smoke-import safety net).
# Usage: scripts/hooks
set -euo pipefail
cd "$(dirname "$0")/.."

echo "[hooks] compileall (byte-compile package + tests)"
python -m compileall -q telegram_documentaries tests

echo "[hooks] smoke import (package must import cleanly)"
python -c "import telegram_documentaries  # noqa: F401"

echo "[hooks] ruff (lint)"
python -m ruff check .

echo "[hooks] mypy (type check)"
python -m mypy telegram_documentaries

echo "[hooks] all checks passed"
